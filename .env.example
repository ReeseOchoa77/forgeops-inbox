APP_ENV=development
NODE_ENV=development
HOST=0.0.0.0
API_PORT=3000
# Dedicated local docker-compose database (NOT Railway production).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forgeops_dev?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/forgeops_dev?schema=public
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173
# Fail-closed: never point local at remote DB/Redis without this intentional escape.
ALLOW_REMOTE_INFRA=false
# Graph push webhooks cannot reach localhost — leave false; use manual sync / historical import.
ALLOW_DEV_GRAPH_WEBHOOKS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SEMANTIC_MODEL=chat-latest
OPENAI_SUBTYPE_MODEL=chat-latest
OPENAI_ENTITY_MODEL=chat-latest
OPENAI_TASK_MODEL=chat-latest
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_INBOX_REDIRECT_URI=http://localhost:3000/api/v1/inbox-connections/google/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/v1/inbox-connections/google/callback
OUTLOOK_TENANT_ID=common
SESSION_COOKIE_NAME=forgeops_session
SESSION_COOKIE_SECRET=replace-me-with-a-long-random-dev-secret
SESSION_TTL_SECONDS=604800
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_TOKEN_ENCRYPTION_SECRET=replace-me-with-32plus-char-dev-encryption-secret
DEV_AUTO_CREATE_WORKSPACE_ON_LOGIN=true
DEV_ENABLE_BOOTSTRAP_ROUTES=true
WORKER_CONCURRENCY=5

# Optional object storage — use a DEV bucket only, never production.
# S3_BUCKET=forgeops-development
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# n8n Integration (machine-to-machine) — leave disabled for local native Graph intake
N8N_INTEGRATION_ENABLED=false
N8N_INTEGRATION_API_KEY=
