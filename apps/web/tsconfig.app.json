{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Resolve browser-safe shared subpaths from source (no Prisma / shared dist). */
    "paths": {
      "@forgeops/shared/business-subtypes": [
        "../../packages/shared/src/business-subtypes.ts"
      ],
      "@forgeops/shared/inbox-participant-match": [
        "../../packages/shared/src/inbox-participant-match.ts"
      ],
      "@forgeops/shared/bidding/scope-detail": [
        "../../packages/shared/src/bidding/scope-detail.ts"
      ],
      "@forgeops/shared/reference/normalize": [
        "../../packages/shared/src/reference/normalize.ts"
      ],
      "@forgeops/shared/jobs/job-match-policy-registry": [
        "../../packages/shared/src/jobs/job-match-policy-registry.ts"
      ],
      "@forgeops/shared/jobs/job-match-eval-exclusions": [
        "../../packages/shared/src/jobs/job-match-eval-exclusions.ts"
      ]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
