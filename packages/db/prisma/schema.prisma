generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum PlatformRole {
  PLATFORM_ADMIN
  STANDARD_USER
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum MailboxStatus {
  ACTIVE
  PAUSED
  DISCONNECTED
  ERROR
}

enum IngestionMode {
  NATIVE
  N8N
}

enum InboxProvider {
  GMAIL
  OUTLOOK
}

enum ApprovedAccessStatus {
  ACTIVE
  REVOKED
}

enum InboxConnectionStatus {
  ACTIVE
  PAUSED
  ERROR
  REQUIRES_REAUTH
  DISCONNECTED
}

enum IngestionSource {
  NATIVE
  N8N
  /// Reserved — not implemented for production writes yet.
  SHADOW
}

enum MailboxHistoricalImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BusinessCategory {
  BUSINESS
  NON_BUSINESS
}

enum MailboxCategory {
  BUSINESS
  PERSONAL
  SPAM
  TRASH
}

enum EmailType {
  ACTIONABLE_REQUEST
  FYI_UPDATE
  SALES_MARKETING
  SUPPORT_CUSTOMER_ISSUE
  RECRUITING_HIRING
  INTERNAL_COORDINATION
  NEEDS_REVIEW
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ItemStatus {
  NEW
  NEEDS_REVIEW
  ROUTED
  IN_PROGRESS
  RESOLVED
  CLOSED
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum ReviewQueue {
  TRIAGE
  EXTRACTION
  ROUTING
  QA
}

enum ReviewStatus {
  NOT_REQUIRED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

/// Queue/worker lifecycle for native classification (orthogonal to ReviewStatus).
enum ClassificationProcessingStatus {
  PENDING
  PROCESSING
  CLASSIFIED
  FAILED
}

enum RoutingRuleActionType {
  ASSIGN
  SET_PRIORITY
  SET_STATUS
  CREATE_TASK
  SEND_TO_REVIEW_QUEUE
}

/// Workspace is the tenant boundary. Every operational record below is scoped
/// to a workspace to keep inbox data isolated in a multi-tenant deployment.
enum JobStatus {
  LEAD
  BIDDING
  AWARDED
  ACTIVE
  ON_HOLD
  COMPLETE
  ARCHIVED
  COMPLETED
  CANCELLED
}

enum JobAssignmentSource {
  AI_SUGGESTED
  AI_AUTO_ASSIGNED
  USER_ASSIGNED
  FOLDER_ALIAS
  JOB_NUMBER_MATCH
  IMPORT
  VERIFIED_PROJECT_FOLDER
}

enum JobActivityAction {
  JOB_CREATED
  JOB_UPDATED
  JOB_ARCHIVED
  JOB_RESTORED
  JOB_STATUS_CHANGED
  EMAIL_ASSIGNED
  EMAIL_REMOVED
  EMAIL_REASSIGNED
  TASK_LINKED
  TASK_REMOVED
  MEMBER_ADDED
  MEMBER_REMOVED
  ALIAS_ADDED
  ALIAS_REMOVED
  CUSTOMER_CHANGED
  FOLDER_CREATED
  FOLDER_RENAMED
  FOLDER_DELETED
  DOCUMENT_UPLOADED
  DOCUMENT_MOVED
  DOCUMENT_DELETED
  PARTICIPANT_ADDED
  PARTICIPANT_UPDATED
  PARTICIPANT_REMOVED
  WORK_PACKAGE_CREATED
  WORK_PACKAGE_UPDATED
  WORK_PACKAGE_DELETED
  FABRICATION_ITEM_MOVED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_COMPLETED
  MILESTONE_REOPENED
  MILESTONE_CANCELLED
  MILESTONE_DELETED
  DOCUMENT_CLASSIFIED
  DOCUMENT_METADATA_UPDATED
  DOCUMENT_SUPERSEDED
  DOCUMENT_CONTROL_CLEARED
  RFI_CREATED
  RFI_UPDATED
  RFI_ANSWERED
  RFI_CLOSED
  RFI_CANCELLED
  DIRECTIVE_CREATED
  DIRECTIVE_UPDATED
  DIRECTIVE_VOIDED
  CHANGE_CREATED
  CHANGE_UPDATED
  CHANGE_STATUS_CHANGED
  CHANGE_ORDER_CREATED
  CHANGE_ORDER_UPDATED
  CHANGE_ORDER_STATUS_CHANGED
  PROCUREMENT_ITEM_CREATED
  PROCUREMENT_ITEM_UPDATED
  PROCUREMENT_ITEM_CANCELLED
  PROCUREMENT_RECEIPT_RECORDED
  PROCUREMENT_ITEM_COMPLETED
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_UPDATED
  PURCHASE_ORDER_ISSUED
  PURCHASE_ORDER_CANCELLED
  DELIVERY_CREATED
  DELIVERY_UPDATED
  DELIVERY_SHIPPED
  DELIVERY_DELIVERED
  DELIVERY_CANCELLED
  DELIVERY_LINE_ADDED
  DELIVERY_LINE_REMOVED
  INSTALLATION_RECORDED
  INSTALLATION_UPDATED
  ORIGINAL_CONTRACT_VALUE_UPDATED
  ORIGINAL_ESTIMATED_COST_UPDATED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_SUBMITTED
  INVOICE_APPROVED
  INVOICE_REJECTED
  INVOICE_VOIDED
  INVOICE_DELETED
  RFQ_CREATED
  RFQ_UPDATED
  RFQ_STATUS_CHANGED
  RFQ_DELETED
}

/// Outbound fabricated product delivery (not procurement inbound receipt).
enum JobShipmentStatus {
  PLANNED
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// Site erection/installation event. Distinct from delivery-to-site.
enum JobInstallationEventType {
  STARTED
  PROGRESS
  COMPLETED
}

/// Broad procurement taxonomy. Steel shapes belong in description, not enums.
enum JobProcurementCategory {
  MATERIAL
  JOIST_DECK
  HARDWARE
  COATING
  OUTSOURCED_FABRICATION
  DETAILING
  ENGINEERING
  TESTING
  OTHER
}

/// Where a procurement requirement sits in the buying/receiving workflow.
enum JobProcurementItemStatus {
  NEEDED
  PRICING
  READY_TO_ORDER
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Commercial purchase order status. No AP/payment states.
enum JobPurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Formal clarification request. Distinct from email subtype RFI_CLARIFICATION.
enum JobRfiStatus {
  DRAFT
  OPEN
  ANSWERED
  CLOSED
  CANCELLED
}

/// Formal project directive (instruction/revision). Not an RFI.
enum JobDirectiveType {
  ASI
  BULLETIN
  ADDENDUM
  OTHER
}

enum JobDirectiveStatus {
  ACTIVE
  VOID
}

/// Operational/commercial scope delta. Distinct from formal Change Order.
enum JobChangeType {
  EXTRA
  CREDIT
  SCOPE_CHANGE
  REWORK
  BACKCHARGE
  OTHER
}

enum JobChangeStatus {
  IDENTIFIED
  PRICING
  PROPOSED
  APPROVED
  REJECTED
  VOID
}

/// Formal commercial Change Order that may bundle multiple Changes.
enum JobChangeOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  VOID
}

/// Project billing invoice / pay-application record. Not AR/payment tracking.
/// SUBMITTED = sent/issued to bill-to. No PAID states in Phase I.
enum JobInvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  VOID
}

/// Project-document semantic type. Distinct from MIME fileType buckets and KnowledgeDocument DocumentType.
enum JobDocumentRecordType {
  OTHER
  ARCHITECTURAL_DRAWING
  STRUCTURAL_DRAWING
  CIVIL_DRAWING
  SPECIFICATION
  SHOP_DRAWING
  SUBMITTAL
  RFI_DOCUMENT
  ASI
  BULLETIN
  ADDENDUM
  PROPOSAL_QUOTE
  PURCHASE_ORDER
  CONTRACT
  CHANGE_ORDER
  INVOICE
  DELIVERY_DOCUMENT
}

/// Submittal/shop-drawing workflow only. Not used for invoices, contracts, etc.
enum JobDocumentSubmittalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  APPROVED_AS_NOTED
  REVISE_AND_RESUBMIT
  REJECTED
}

/// Operational schedule checkpoint. Does not replace CalendarEvent appointments
/// or future procurement/shipping entities.
enum JobMilestoneType {
  GENERAL
  SHOP_DRAWINGS
  SUBMITTAL
  APPROVAL
  FIELD_MEASURE
  MATERIAL_REQUIRED
  MATERIAL_ORDERED
  MATERIAL_EXPECTED
  FABRICATION_START
  FABRICATION_COMPLETE
  READY_TO_SHIP
  DELIVERY
  INSTALLATION_START
  INSTALLATION_COMPLETE
  PROJECT_COMPLETE
}

/// Canonical milestone lifecycle. OVERDUE is derived from plannedDate + OPEN — not stored.
enum JobMilestoneStatus {
  OPEN
  COMPLETE
  CANCELLED
}

/// Operational subdivision of a Job (area, stair, rails, etc.). Does not replace Job.status.
enum JobWorkPackageStatus {
  NOT_STARTED
  DETAILING
  AWAITING_APPROVAL
  FIELD_MEASURE
  READY_FOR_FABRICATION
  FABRICATING
  READY_TO_SHIP
  DELIVERED
  INSTALLING
  COMPLETE
  ON_HOLD
}

/// Estimating RFQ lifecycle (Request for Quote) — distinct from RFI and Procurement PO.
enum JobRfqStatus {
  DRAFT
  REQUESTED
  RECEIVED
  DECLINED
  CANCELLED
}

/// Project-team role on a Job. Complements estimatorUserId / contractorCustomerId / clientCustomerId.
enum JobParticipantRole {
  PROJECT_MANAGER
  ESTIMATOR
  GENERAL_CONTRACTOR
  CLIENT
  OWNER
  ARCHITECT
  ENGINEER
  DETAILER
  ERECTOR
  SUPPLIER
  OTHER
}

enum JobParticipantPartyType {
  USER
  CUSTOMER
  VENDOR
  CONTACT
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  timezone         String            @default("UTC")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      Membership[]
  inboxConnections InboxConnection[]
  emailThreads     EmailThread[]
  emailMessages    EmailMessage[]
  normalizedEmails NormalizedEmail[]
  classifications  Classification[]
  tasks            Task[]
  routingRules     RoutingRule[]
  setting          WorkspaceSetting?
  auditEvents      AuditEvent[]
  approvedAccess   ApprovedAccess[]
  customers        Customer[]
  vendors          Vendor[]
  jobs             Job[]
  entityAliases    EntityAlias[]
  entityContacts   EntityContact[]
  knowledgeDocs    KnowledgeDocument[]
  importRuns       ImportRun[]
  workspaceMailboxes WorkspaceMailbox[]
  historicalImports  MailboxHistoricalImport[]
  businessTypes      BusinessType[]
  classificationCorrections ClassificationCorrection[]
  classificationInstructions ClassificationInstruction[]
  discoveredFolders    DiscoveredFolder[]
  jobFolderRoots       JobFolderRoot[]
  projectFolderEmailAnalyzeRuns ProjectFolderEmailAnalyzeRun[]
  mailboxReclassifyRuns MailboxReclassifyRun[]
  senderEvidence       SenderEvidence[]
  domainEvidence       DomainEvidence[]
  emailAttachments     EmailAttachment[]
  inlineImageRelevanceClassifications InlineImageRelevanceClassification[]
  jobActivityLogs      JobActivityLog[]
  jobDocumentFolders   JobDocumentFolder[]
  jobFiles             JobFile[]
  calendarEvents       CalendarEvent[]
  jobParticipants      JobParticipant[]
  jobWorkPackages      JobWorkPackage[]
  jobRfqs              JobRfq[]
  jobMilestones        JobMilestone[]
  jobDocumentRecords   JobDocumentRecord[]
  jobRfis              JobRfi[]
  jobDirectives        JobDirective[]
  jobChanges           JobChange[]
  jobChangeOrders      JobChangeOrder[]
  jobProcurementItems  JobProcurementItem[]
  jobPurchaseOrders    JobPurchaseOrder[]
  jobShipments         JobShipment[]
  jobInstallationRecords JobInstallationRecord[]
  jobInvoices          JobInvoice[]
}

model User {
  id                      String           @id @default(cuid())
  googleSubject           String?          @unique
  microsoftSubject        String?          @unique
  email                   String           @unique
  name                    String?
  avatarUrl               String?
  lastLoginAt             DateTime?
  isPlatformAdmin         Boolean          @default(false)
  platformRole            PlatformRole     @default(STANDARD_USER)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  memberships             Membership[]
  assignedThreads         EmailThread[]    @relation("ThreadAssignee")
  assignedTasks           Task[]           @relation("TaskAssignee")
  reviewedClassifications Classification[] @relation("ClassificationReviewer")
  reviewedTasks           Task[]           @relation("TaskReviewer")
  createdRoutingRules     RoutingRule[]    @relation("RoutingRuleCreator")
  updatedRoutingRules     RoutingRule[]    @relation("RoutingRuleUpdater")
  auditEvents             AuditEvent[]     @relation("AuditActor")
  invitedAccess           ApprovedAccess[] @relation("ApprovedAccessInviter")
  createdDocuments        KnowledgeDocument[] @relation("DocumentCreator")
  createdCalendarEvents   CalendarEvent[] @relation("CalendarEventCreator")
  classificationCorrections ClassificationCorrection[] @relation("CorrectionReviewer")
  classificationInstructions ClassificationInstruction[] @relation("InstructionCreator")
  estimatedJobs           Job[]            @relation("JobEstimator")
  jobParticipations       JobParticipant[] @relation("JobParticipantUser")
}

model ApprovedAccess {
  id              String               @id @default(cuid())
  email           String
  workspaceId     String
  role            Role                 @default(MEMBER)
  workspaceRole   WorkspaceRole        @default(VIEWER)
  status          ApprovedAccessStatus @default(ACTIVE)
  invitedByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser   User?                @relation("ApprovedAccessInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId, status])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role            Role          @default(MEMBER)
  workspaceRole   WorkspaceRole @default(VIEWER)
  /// User-specific default mailbox for Inbox (not workspace-global).
  pinnedInboxConnectionId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinnedInboxConnection InboxConnection? @relation("MembershipPinnedMailbox", fields: [pinnedInboxConnectionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@index([workspaceId, workspaceRole])
  @@index([pinnedInboxConnectionId])
}

model InboxConnection {
  id                String                @id @default(cuid())
  workspaceId       String
  provider          InboxProvider         @default(GMAIL)
  email             String
  displayName       String?
  providerAccountId String?
  status            InboxConnectionStatus @default(ACTIVE)
  /// Processing ownership: N8N remains authoritative until explicitly set to NATIVE.
  ingestionSource   IngestionSource       @default(N8N)
  /// Explicit native listener — OAuth must never flip this on automatically.
  nativeListeningEnabled Boolean          @default(false)
  listenIncoming    Boolean               @default(true)
  listenSent        Boolean               @default(false)
  excludeJunk       Boolean               @default(true)
  excludeTrash      Boolean               @default(true)
  grantedScopes     String[]              @default([])
  encryptedAccessToken String?
  encryptedRefreshToken String?
  accessTokenExpiresAt DateTime?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  syncCursor        String?
  lastSyncStartedAt DateTime?
  lastSyncedAt      DateTime?
  lastSyncErrorAt   DateTime?
  lastSyncError     String?
  pushSubscriptionId String?
  pushExpiresAt     DateTime?
  lastReceivedAt    DateTime?
  lastProcessedAt   DateTime?
  lastErrorMessage  String?
  /// After Clear Inbox: live sync must not re-import provider messages at/before this instant.
  /// Historical Import may bypass intentionally.
  inboxClearedAt    DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threads           EmailThread[]
  messages          EmailMessage[]
  normalizedEmails  NormalizedEmail[]
  workspaceMailboxes WorkspaceMailbox[]
  historicalImports MailboxHistoricalImport[]
  pinnedByMemberships Membership[] @relation("MembershipPinnedMailbox")

  @@unique([workspaceId, id])
  @@unique([workspaceId, provider, email])
  @@index([providerAccountId])
  @@index([workspaceId, email])
  @@index([workspaceId, providerAccountId])
  @@index([workspaceId, provider])
  @@index([workspaceId, status])
  @@index([provider, email, ingestionSource])
  @@index([workspaceId, nativeListeningEnabled])
}

model MailboxHistoricalImport {
  id                 String                        @id @default(cuid())
  workspaceId        String
  inboxConnectionId  String
  requestedByUserId  String?
  status             MailboxHistoricalImportStatus @default(PENDING)
  /// By count: 1–250. Since date: 0 means unlimited (page until Graph/Gmail exhausted).
  requestedLimit     Int
  /// When set, import targets messages received on/after this instant.
  sinceDate          DateTime?
  processedCount     Int                           @default(0)
  importedCount      Int                           @default(0)
  duplicateCount     Int                           @default(0)
  businessCount      Int                           @default(0)
  personalCount      Int                           @default(0)
  failedCount        Int                           @default(0)
  /// Provider message ids attempted in this run (for progress recount / idempotency).
  processedProviderMessageIds Json                 @default("[]")
  /// Opaque Graph nextLink / Gmail pageToken for mid-import resume. Never write to AuditEvent.
  resumeCursor       String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  workspace          Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxConnection    InboxConnection               @relation(fields: [inboxConnectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, inboxConnectionId, createdAt])
  @@index([inboxConnectionId, status])
}

model EmailThread {
  id                         String        @id @default(cuid())
  workspaceId                String
  inboxConnectionId          String
  unifiedThreadKey           String?
  gmailThreadId              String
  providerThreadId           String?
  subject                    String?
  normalizedSubject          String?
  snippet                    String?
  participants               Json?
  firstMessageAt             DateTime?
  lastMessageAt              DateTime?
  messageCount               Int           @default(0)
  unreadCount                Int           @default(0)
  priority                   Priority?
  itemStatus                 ItemStatus    @default(NEW)
  assignedToUserId           String?
  reviewQueue                ReviewQueue?
  reviewStatus               ReviewStatus  @default(NOT_REQUIRED)
  latestClassificationConfidence Decimal?  @db.Decimal(5, 4)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  workspace                  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxConnection            InboxConnection @relation(fields: [workspaceId, inboxConnectionId], references: [workspaceId, id], onDelete: Cascade)
  assignedToUser             User?         @relation("ThreadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages                   EmailMessage[]
  normalizedEmails           NormalizedEmail[]
  classifications            Classification[]
  tasks                      Task[]        @relation("TaskSourceThread")

  @@unique([workspaceId, id])
  @@unique([inboxConnectionId, gmailThreadId])
  @@index([gmailThreadId])
  @@index([workspaceId, gmailThreadId])
  @@index([providerThreadId])
  @@index([workspaceId, providerThreadId])
  @@index([workspaceId, unifiedThreadKey])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, itemStatus, lastMessageAt])
  @@index([workspaceId, assignedToUserId, itemStatus])
  @@index([workspaceId, reviewQueue, reviewStatus])
}

model EmailMessage {
  id               String        @id @default(cuid())
  workspaceId      String
  inboxConnectionId String
  threadId         String
  gmailMessageId   String
  gmailThreadId    String
  providerMessageId String?
  providerThreadId  String?
  internetMessageId String?
  historyId        String?
  subject          String?
  senderName       String?
  senderEmail      String
  toAddresses      Json?
  ccAddresses      Json?
  bccAddresses     Json?
  replyToAddresses Json?
  snippet          String?
  bodyText         String?
  bodyHtml         String?
  labelIds         String[]      @default([])
  hasAttachments   Boolean       @default(false)
  isRead           Boolean       @default(false)
  isImportant      Boolean       @default(false)
  isTrashed        Boolean       @default(false)
  isSpam           Boolean       @default(false)
  isTestData       Boolean       @default(false)
  /// Import Previous Emails created or refreshed this message.
  fromHistoricalImport Boolean   @default(false)
  /// Verified project-folder analysis created or refreshed this message.
  /// Once set, a later historical import must not make this row removable as imported mail.
  fromProjectFolder Boolean      @default(false)
  isArchived       Boolean       @default(false)
  archivedAt       DateTime?
  mailboxCategory  MailboxCategory @default(BUSINESS)
  trashedAt        DateTime?
  trashedBy        String?
  previousCategory MailboxCategory?
  attachmentMetadata Json?
  sentAt           DateTime
  receivedAt       DateTime?
  priority         Priority?
  itemStatus       ItemStatus    @default(NEW)
  jobId                   String?
  jobMatchConfidence      Float?
  jobMatchEvidence        Json?
  jobAssignmentSource     JobAssignmentSource?
  jobAssignedAt           DateTime?
  jobAssignedByUserId     String?
  jobAssignmentIsManual   Boolean  @default(false)
  isPinned         Boolean       @default(false)
  pinnedAt         DateTime?
  /// Native classify queue lifecycle — null means never attempted / unknown.
  classificationStatus          ClassificationProcessingStatus?
  classificationLastAttemptAt   DateTime?
  classificationAttemptCount    Int       @default(0)
  /// Truncated last error for FAILED/debug — never stack traces or provider payloads.
  classificationError           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxConnection  InboxConnection @relation(fields: [workspaceId, inboxConnectionId], references: [workspaceId, id], onDelete: Cascade)
  thread           EmailThread   @relation(fields: [workspaceId, threadId], references: [workspaceId, id], onDelete: Cascade)
  job              Job?          @relation("MessageJob", fields: [jobId], references: [id], onDelete: SetNull)
  normalizedEmail  NormalizedEmail?
  classifications  Classification[]
  tasks            Task[]        @relation("TaskSourceMessage")
  attachments      EmailAttachment[]
  linkedRfqs       JobRfq[]      @relation("JobRfqEmail")

  @@unique([workspaceId, id])
  @@unique([inboxConnectionId, gmailMessageId])
  @@index([gmailMessageId])
  @@index([gmailThreadId])
  @@index([workspaceId, gmailMessageId])
  @@index([workspaceId, gmailThreadId])
  @@index([providerMessageId])
  @@index([providerThreadId])
  @@index([workspaceId, providerMessageId])
  @@index([workspaceId, providerThreadId])
  @@index([workspaceId, inboxConnectionId, receivedAt])
  @@index([workspaceId, historyId])
  @@index([workspaceId, sentAt])
  @@index([workspaceId, mailboxCategory, receivedAt])
  @@index([workspaceId, threadId, sentAt])
  @@index([workspaceId, itemStatus, sentAt])
  @@index([senderEmail])
  @@index([jobId])
  @@index([workspaceId, jobId, sentAt])
  @@index([workspaceId, inboxConnectionId, isTrashed, isArchived, receivedAt])
  @@index([workspaceId, inboxConnectionId, classificationStatus, createdAt])
}

model NormalizedEmail {
  id               String          @id @default(cuid())
  workspaceId      String
  inboxConnectionId String
  threadId         String
  messageId        String
  sender           Json
  recipients       Json
  subject          String?
  normalizedSubject String?
  snippet          String?
  receivedAt       DateTime?
  cleanTextBody    String?
  labelHints       String[]        @default([])
  categoryHints    String[]        @default([])
  senderDomain     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxConnection  InboxConnection @relation(fields: [workspaceId, inboxConnectionId], references: [workspaceId, id], onDelete: Cascade)
  thread           EmailThread     @relation(fields: [workspaceId, threadId], references: [workspaceId, id], onDelete: Cascade)
  message          EmailMessage    @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, messageId])
  @@index([workspaceId, inboxConnectionId, receivedAt])
  @@index([workspaceId, senderDomain])
}

model Classification {
  id                    String       @id @default(cuid())
  workspaceId           String
  threadId              String
  messageId             String?
  businessCategory      BusinessCategory?
  emailType             EmailType
  priority              Priority?
  itemStatus            ItemStatus?
  summary               String?
  companyName           String?
  projectName           String?
  deadline              DateTime?
  containsActionRequest Boolean      @default(false)
  routingHints          Json?
  extractedFields       Json?
  confidence            Decimal      @db.Decimal(5, 4)
  requiresReview        Boolean      @default(false)
  reviewQueue           ReviewQueue?
  reviewStatus          ReviewStatus @default(NOT_REQUIRED)
  reviewedByUserId      String?
  reviewedAt            DateTime?
  modelName             String?
  modelVersion          String?
  customerId            String?
  vendorId              String?
  jobId                 String?
  mailboxCategory       MailboxCategory?
  mailboxConfidence     Decimal?     @db.Decimal(5, 4)
  businessTypeKey       String?
  businessTypeConfidence Decimal?    @db.Decimal(5, 4)
  entityMatchConfidence Decimal?     @db.Decimal(5, 4)
  matchEvidence         Json?
  rawAiPayload          Json?
  classificationEvidence Json?
  candidateIds          Json?
  classifierVersion     String?
  promptVersion         String?
  processedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  workspace             Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread                EmailThread  @relation(fields: [workspaceId, threadId], references: [workspaceId, id], onDelete: Cascade)
  message               EmailMessage? @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: SetNull)
  reviewedByUser        User?        @relation("ClassificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  customer              Customer?    @relation("ClassificationCustomer", fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: SetNull)
  vendor                Vendor?      @relation("ClassificationVendor", fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: SetNull)
  job                   Job?         @relation("ClassificationJob", fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: SetNull)
  tasks                 Task[]
  corrections           ClassificationCorrection[]

  @@unique([workspaceId, id])
  @@index([workspaceId, businessCategory])
  @@index([workspaceId, emailType])
  @@index([workspaceId, priority])
  @@index([workspaceId, itemStatus])
  @@index([workspaceId, confidence])
  @@index([workspaceId, reviewQueue, reviewStatus])
  @@index([workspaceId, requiresReview, confidence])
  @@unique([workspaceId, messageId])
  @@index([threadId, createdAt])
  @@index([messageId])
  @@index([messageId, businessCategory, businessTypeKey])
  @@index([customerId])
  @@index([vendorId])
  @@index([jobId])
}

model Task {
  id               String       @id @default(cuid())
  workspaceId      String
  sourceThreadId   String
  sourceMessageId  String?
  classificationId String?
  assigneeUserId   String?
  assigneeGuess    String?
  sourceTaskKey    String?
  title            String
  summary          String?
  description      String?
  dueAt            DateTime?
  priority         Priority     @default(MEDIUM)
  status           TaskStatus   @default(OPEN)
  confidence       Decimal      @db.Decimal(5, 4)
  requiresReview   Boolean      @default(false)
  reviewQueue      ReviewQueue?
  reviewStatus     ReviewStatus @default(NOT_REQUIRED)
  reviewedByUserId String?
  reviewedAt       DateTime?
  completedAt      DateTime?
  dismissedAt      DateTime?
  dismissedBy      String?
  dismissalReason  String?
  isPinned         Boolean       @default(false)
  pinnedAt         DateTime?
  customerId       String?
  vendorId         String?
  jobId            String?
  /// Canonical timeline date for Task list filters / bulk delete (email receivedAt/sentAt for email-sourced tasks).
  /// Distinct from createdAt (DB insert) and dueAt (deadline).
  sourceDate       DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceThread     EmailThread  @relation("TaskSourceThread", fields: [workspaceId, sourceThreadId], references: [workspaceId, id], onDelete: Cascade)
  sourceMessage    EmailMessage? @relation("TaskSourceMessage", fields: [workspaceId, sourceMessageId], references: [workspaceId, id], onDelete: SetNull)
  classification   Classification? @relation(fields: [workspaceId, classificationId], references: [workspaceId, id], onDelete: SetNull)
  assigneeUser     User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  reviewedByUser   User?        @relation("TaskReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  customer         Customer?    @relation("TaskCustomer", fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: SetNull)
  vendor           Vendor?      @relation("TaskVendor", fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: SetNull)
  job              Job?         @relation("TaskJob", fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: SetNull)
  calendarEvents   CalendarEvent[] @relation("CalendarEventTask")

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, assigneeUserId, status])
  @@index([workspaceId, priority, status])
  @@index([workspaceId, confidence])
  @@index([workspaceId, reviewQueue, reviewStatus])
  @@unique([workspaceId, sourceMessageId, sourceTaskKey])
  @@index([sourceThreadId])
  @@index([sourceMessageId])
  @@index([classificationId])
  @@index([customerId])
  @@index([vendorId])
  @@index([jobId])
  @@index([workspaceId, sourceDate])
}

/// ForgeOps-native calendar item (meetings/events/notes). Task due dates are aggregated separately, not duplicated here.
model CalendarEvent {
  id                   String    @id @default(cuid())
  workspaceId          String
  title                String
  description          String?
  startAt              DateTime
  endAt                DateTime?
  allDay               Boolean   @default(false)
  /// MEETING | EVENT | NOTE | DEADLINE (TASK type is rendered from Task.dueAt, not stored here)
  type                 String    @default("EVENT")
  /// FORGEOPS | GOOGLE | MICROSOFT
  source               String    @default("FORGEOPS")
  externalEventId      String?
  linkedJobId          String?
  linkedTaskId         String?
  linkedEmailMessageId String?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedJob            Job?      @relation("CalendarEventJob", fields: [linkedJobId], references: [id], onDelete: SetNull)
  linkedTask           Task?     @relation("CalendarEventTask", fields: [linkedTaskId], references: [id], onDelete: SetNull)
  createdByUser        User?     @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
  @@index([workspaceId, type])
  @@index([linkedJobId])
  @@index([linkedTaskId])
  @@index([workspaceId, source, externalEventId])
}

/// Domain entity: a customer/client the workspace does business with.
/// Designed for spreadsheet import. Matching to emails is deferred.
model Customer {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  normalizedName  String
  primaryEmail    String?
  domain          String?
  phone           String?
  externalRef     String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs            Job[]     @relation("JobCustomer")
  contractorJobs  Job[]     @relation("JobContractor")
  clientJobs      Job[]     @relation("JobClient")
  classifications Classification[] @relation("ClassificationCustomer")
  tasks           Task[]    @relation("TaskCustomer")
  aliases         EntityAlias[]
  contacts        EntityContact[]
  jobParticipations JobParticipant[] @relation("JobParticipantCustomer")
  billedInvoices    JobInvoice[]     @relation("JobInvoiceBillTo")

  @@unique([workspaceId, id])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, domain])
  @@index([workspaceId, primaryEmail])
  @@index([workspaceId, externalRef])
}

/// Domain entity: a vendor/supplier the workspace works with.
model Vendor {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  normalizedName  String
  primaryEmail    String?
  domain          String?
  phone           String?
  externalRef     String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classifications Classification[] @relation("ClassificationVendor")
  tasks           Task[]    @relation("TaskVendor")
  aliases         EntityAlias[]
  contacts        EntityContact[]
  jobParticipations JobParticipant[] @relation("JobParticipantVendor")
  procurementItems  JobProcurementItem[]
  purchaseOrders    JobPurchaseOrder[]
  jobRfqs           JobRfq[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, domain])
  @@index([workspaceId, primaryEmail])
  @@index([workspaceId, externalRef])
}

/// Domain entity: a job/project tied to a customer.
model Job {
  id                    String     @id @default(cuid())
  workspaceId           String
  jobNumber             String?
  name                  String
  normalizedName        String
  customerId            String?
  status                JobStatus  @default(ACTIVE)
  description           String?
  externalRef           String?
  notes                 String?
  startDate             DateTime?
  targetCompletionDate  DateTime?
  /// Pre-award bid deadline. Independent of start/target completion.
  bidDueAt              DateTime?
  /// Entered total cost for the job. Null means unknown, not zero.
  /// This is not derived from fabrication items.
  /// Legacy / ambiguous — do not treat as contract value or estimated cost.
  totalCost             Decimal?   @db.Decimal(14, 2)
  /// Canonical original sell/contract value before approved Change Orders.
  /// NULL = unknown / not entered. 0 = explicit zero. Not backfilled from totalCost.
  originalContractValue Decimal?   @db.Decimal(14, 2)
  /// Canonical original internal cost estimate baseline.
  /// NULL = unknown / not entered. 0 = explicit zero. Not derived from procurement or fab hours.
  originalEstimatedCost Decimal?   @db.Decimal(14, 2)
  /// Default project/site destination. Not a Customer billing address.
  /// Shipment destination snapshots are independent historical copies.
  siteName              String?
  siteAddress1          String?
  siteAddress2          String?
  siteCity              String?
  siteState             String?
  sitePostalCode        String?
  /// Assigned estimator. Distinct from createdByUserId.
  estimatorUserId       String?
  /// General contractor, stored as an existing Customer. Distinct from client and from customerId.
  contractorCustomerId  String?
  /// End client, stored as an existing Customer. Distinct from the contractor.
  clientCustomerId      String?
  archivedAt            DateTime?
  createdByUserId       String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  workspace             Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer              Customer?  @relation("JobCustomer", fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: SetNull)
  estimator             User?      @relation("JobEstimator", fields: [estimatorUserId], references: [id], onDelete: SetNull)
  contractor            Customer?  @relation("JobContractor", fields: [workspaceId, contractorCustomerId], references: [workspaceId, id], onDelete: SetNull)
  client                Customer?  @relation("JobClient", fields: [workspaceId, clientCustomerId], references: [workspaceId, id], onDelete: SetNull)
  fabricationItems      JobFabricationItem[]
  classifications       Classification[] @relation("ClassificationJob")
  tasks                 Task[]     @relation("TaskJob")
  aliases               EntityAlias[]
  discoveredFolders     DiscoveredFolder[]
  members               JobMember[]
  activityLogs          JobActivityLog[]
  assignedEmails        EmailMessage[] @relation("MessageJob")
  documentFolders       JobDocumentFolder[]
  files                 JobFile[]
  knowledgeDocuments    KnowledgeDocument[] @relation("JobKnowledgeDocuments")
  calendarEvents        CalendarEvent[] @relation("CalendarEventJob")
  /// Additional project parties. Does not replace estimator/contractor/client FKs.
  participants          JobParticipant[]
  workPackages          JobWorkPackage[]
  milestones            JobMilestone[]
  documentRecords       JobDocumentRecord[]
  rfis                  JobRfi[]
  directives            JobDirective[]
  changes               JobChange[]
  changeOrders          JobChangeOrder[]
  procurementItems      JobProcurementItem[]
  purchaseOrders        JobPurchaseOrder[]
  shipments             JobShipment[]
  installationRecords   JobInstallationRecord[]
  invoices              JobInvoice[]
  rfqs                  JobRfq[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, jobNumber])
  @@index([workspaceId, customerId])
  @@index([workspaceId, status])
  @@index([workspaceId, status, bidDueAt])
  @@index([workspaceId, externalRef])
  @@index([workspaceId, archivedAt])
  @@index([createdByUserId])
}

/// Additional project party on a Job. Complements estimatorUserId / contractorCustomerId / clientCustomerId.
/// Exactly one of userId / customerId / vendorId / contactId is set (enforced in application).
model JobParticipant {
  id           String                  @id @default(cuid())
  workspaceId  String
  jobId        String
  role         JobParticipantRole
  partyType    JobParticipantPartyType
  userId       String?
  customerId   String?
  vendorId     String?
  contactId    String?
  /// Preferred for PROJECT_MANAGER when multiple PMs exist.
  isPrimary    Boolean                 @default(false)
  title        String?
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job          Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user         User?                   @relation("JobParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  customer     Customer?               @relation("JobParticipantCustomer", fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Cascade)
  vendor       Vendor?                 @relation("JobParticipantVendor", fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: Cascade)
  contact      EntityContact?          @relation("JobParticipantContact", fields: [contactId], references: [id], onDelete: Cascade)
  rfisRequested JobRfi[]               @relation("RfiRequestedBy")
  rfisAssigned  JobRfi[]               @relation("RfiAssignedTo")
  installationRecords JobInstallationRecord[]

  @@unique([jobId, role, userId])
  @@unique([jobId, role, customerId])
  @@unique([jobId, role, vendorId])
  @@unique([jobId, role, contactId])
  @@index([workspaceId, jobId])
  @@index([workspaceId, role])
  @@index([jobId, role, isPrimary])
}

/// Operational subdivision of a Job's physical/fabrication scope.
/// Status is manually controlled. Does not replace Job.status.
model JobWorkPackage {
  id           String               @id @default(cuid())
  workspaceId  String
  jobId        String
  /// Optional parent for shallow hierarchy (e.g. Structural → Area A). One level intended.
  parentId     String?
  name         String
  description  String?
  status       JobWorkPackageStatus @default(NOT_STARTED)
  sortOrder    Int                  @default(0)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job          Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parent       JobWorkPackage?      @relation("JobWorkPackageTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     JobWorkPackage[]     @relation("JobWorkPackageTree")
  fabricationItems JobFabricationItem[]
  milestones   JobMilestone[]
  documentRecords JobDocumentRecord[]
  rfiLinks     JobRfiWorkPackage[]
  directiveLinks JobDirectiveWorkPackage[]
  changeLinks  JobChangeWorkPackage[]
  procurementItems JobProcurementItem[]
  shipmentItems    JobShipmentItem[]
  installationRecords JobInstallationRecord[]
  rfqs                JobRfq[]

  @@index([workspaceId, jobId, sortOrder])
  @@index([jobId, parentId])
  @@index([workspaceId, status])
}

/// Estimating Request for Quote (outside pricing). Distinct from RFI and Procurement PO.
/// quotedAmount NULL = unknown / not entered; 0 = explicit zero. Does not roll into Job cost fields.
model JobRfq {
  id              String       @id @default(cuid())
  workspaceId     String
  jobId           String
  vendorId        String?
  /// Optional link to bid-scope category (JobWorkPackage used as hierarchy during BIDDING).
  workPackageId   String?
  /// Optional manual link to a related EmailMessage (no auto-inference).
  emailMessageId  String?
  title           String
  description     String?
  status          JobRfqStatus @default(DRAFT)
  /// Calendar date (UTC midnight).
  requestedDate   DateTime?
  dueDate         DateTime?
  receivedDate    DateTime?
  quotedAmount    Decimal?     @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vendor          Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  workPackage     JobWorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  emailMessage    EmailMessage? @relation("JobRfqEmail", fields: [emailMessageId], references: [id], onDelete: SetNull)
  documents       JobRfqDocument[]

  @@index([workspaceId, jobId, status])
  @@index([jobId, vendorId])
  @@index([jobId, workPackageId])
  @@index([emailMessageId])
}

/// Links an existing JobDocumentRecord to an RFQ. Does not copy/move binaries.
model JobRfqDocument {
  id               String            @id @default(cuid())
  workspaceId      String
  jobId            String
  rfqId            String
  documentRecordId String
  createdAt        DateTime          @default(now())
  rfq              JobRfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  documentRecord   JobDocumentRecord @relation(fields: [documentRecordId], references: [id], onDelete: Cascade)

  @@unique([rfqId, documentRecordId])
  @@index([jobId, rfqId])
  @@index([documentRecordId])
}

/// Operational schedule event for a Job (or a Work Package within it).
/// plannedDate/actualDate are date-only semantics stored as UTC midnight DateTime
/// (same convention as Job.startDate). OVERDUE is derived, not persisted.
/// Does not auto-update JobWorkPackage.status. Distinct from CalendarEvent.
model JobMilestone {
  id            String             @id @default(cuid())
  workspaceId   String
  jobId         String
  /// Null = Job-level milestone. Non-null must belong to the same job.
  workPackageId String?
  type          JobMilestoneType   @default(GENERAL)
  name          String
  /// Calendar date (UTC midnight). Null = undated / date not set.
  plannedDate   DateTime?
  /// Calendar date (UTC midnight) when completed. Preserved separately from plannedDate.
  actualDate    DateTime?
  status        JobMilestoneStatus @default(OPEN)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job           Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Restrict: package delete is blocked while milestones exist (service 409 + DB).
  workPackage   JobWorkPackage?    @relation(fields: [workPackageId], references: [id], onDelete: Restrict)

  @@index([workspaceId, jobId, plannedDate])
  @@index([workspaceId, jobId, status])
  @@index([jobId, workPackageId])
}

/// Project-document control metadata over an existing JobFile or EmailAttachment.
/// Does NOT store or copy bytes. Source remains canonical. XOR: exactly one of
/// jobFileId / emailAttachmentId (enforced in application).
model JobDocumentRecord {
  id                 String                     @id @default(cuid())
  workspaceId        String
  jobId              String
  jobFileId          String?                    @unique
  emailAttachmentId  String?                    @unique
  documentType       JobDocumentRecordType      @default(OTHER)
  documentNumber     String?
  title              String?
  revision           String?
  /// Calendar date (UTC midnight) for the document issue/drawing date.
  documentDate       DateTime?
  workPackageId      String?
  /// Only meaningful for SHOP_DRAWING / SUBMITTAL. Null otherwise.
  submittalStatus    JobDocumentSubmittalStatus?
  /// False when superseded by a newer controlled revision.
  isCurrent          Boolean                    @default(true)
  /// Points at the older record this one replaces (same job).
  supersedesId       String?
  notes              String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job                Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobFile            JobFile?                   @relation(fields: [jobFileId], references: [id], onDelete: Cascade)
  emailAttachment    EmailAttachment?           @relation(fields: [emailAttachmentId], references: [id], onDelete: Cascade)
  workPackage        JobWorkPackage?            @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  supersedes         JobDocumentRecord?         @relation("DocumentRevision", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       JobDocumentRecord[]        @relation("DocumentRevision")
  rfiLinks           JobRfiDocument[]
  directiveLinks     JobDirectiveDocument[]
  purchaseOrders     JobPurchaseOrder[]
  shipmentDocuments  JobShipmentDocument[]
  invoices           JobInvoice[]
  rfqLinks           JobRfqDocument[]

  @@index([workspaceId, jobId, documentType])
  @@index([workspaceId, jobId, isCurrent])
  @@index([jobId, workPackageId])
  @@index([jobId, documentNumber])
}

/// Formal RFI / clarification workflow. Distinct from email subtype and RFI_DOCUMENT files.
model JobRfi {
  id                       String          @id @default(cuid())
  workspaceId              String
  jobId                    String
  number                   String
  subject                  String
  question                 String?
  status                   JobRfiStatus    @default(DRAFT)
  submittedDate            DateTime?
  responseDueDate          DateTime?
  answeredDate             DateTime?
  response                 String?
  requestedByParticipantId String?
  assignedToParticipantId  String?
  notes                    String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  workspace                Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job                      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy              JobParticipant? @relation("RfiRequestedBy", fields: [requestedByParticipantId], references: [id], onDelete: SetNull)
  assignedTo               JobParticipant? @relation("RfiAssignedTo", fields: [assignedToParticipantId], references: [id], onDelete: SetNull)
  workPackages             JobRfiWorkPackage[]
  documents                JobRfiDocument[]
  changes                  JobChange[]     @relation("ChangeSourceRfi")

  @@index([workspaceId, jobId, status])
  @@index([jobId, number])
  @@index([jobId, responseDueDate])
}

model JobRfiWorkPackage {
  id            String         @id @default(cuid())
  rfiId         String
  workPackageId String
  rfi           JobRfi         @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  workPackage   JobWorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@unique([rfiId, workPackageId])
  @@index([workPackageId])
}

model JobRfiDocument {
  id               String            @id @default(cuid())
  rfiId            String
  documentRecordId String
  rfi              JobRfi            @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  documentRecord   JobDocumentRecord @relation(fields: [documentRecordId], references: [id], onDelete: Cascade)

  @@unique([rfiId, documentRecordId])
  @@index([documentRecordId])
}

/// Formal project directive (ASI / Bulletin / Addendum). Not an RFI.
model JobDirective {
  id          String             @id @default(cuid())
  workspaceId String
  jobId       String
  type        JobDirectiveType
  status      JobDirectiveStatus @default(ACTIVE)
  number      String
  title       String
  issuedDate  DateTime?
  summary     String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workPackages JobDirectiveWorkPackage[]
  documents   JobDirectiveDocument[]
  changes     JobChange[]        @relation("ChangeSourceDirective")

  @@index([workspaceId, jobId, type])
  @@index([jobId, number])
}

model JobDirectiveWorkPackage {
  id            String         @id @default(cuid())
  directiveId   String
  workPackageId String
  directive     JobDirective   @relation(fields: [directiveId], references: [id], onDelete: Cascade)
  workPackage   JobWorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@unique([directiveId, workPackageId])
  @@index([workPackageId])
}

model JobDirectiveDocument {
  id               String            @id @default(cuid())
  directiveId      String
  documentRecordId String
  directive        JobDirective      @relation(fields: [directiveId], references: [id], onDelete: Cascade)
  documentRecord   JobDocumentRecord @relation(fields: [documentRecordId], references: [id], onDelete: Cascade)

  @@unique([directiveId, documentRecordId])
  @@index([documentRecordId])
}

/// Operational/commercial change. costImpact/sellImpact NULL = unknown; 0 = explicit zero.
/// Does not mutate Job.totalCost, fabrication, milestones, or package status.
model JobChange {
  id                String          @id @default(cuid())
  workspaceId       String
  jobId             String
  number            String
  title             String
  description       String?
  type              JobChangeType   @default(SCOPE_CHANGE)
  status            JobChangeStatus @default(IDENTIFIED)
  sourceRfiId       String?
  sourceDirectiveId String?
  changeOrderId     String?
  /// Internal cost impact. NULL = not priced; 0 = no cost impact.
  costImpact        Decimal?        @db.Decimal(14, 2)
  /// Customer/contract sell impact. NULL = not priced; 0 = no sell impact.
  sellImpact        Decimal?        @db.Decimal(14, 2)
  scheduleImpactDays Int?
  scheduleImpactNote String?
  identifiedDate    DateTime?
  proposedDate      DateTime?
  approvedDate      DateTime?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job               Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceRfi         JobRfi?         @relation("ChangeSourceRfi", fields: [sourceRfiId], references: [id], onDelete: SetNull)
  sourceDirective   JobDirective?   @relation("ChangeSourceDirective", fields: [sourceDirectiveId], references: [id], onDelete: SetNull)
  /// Restrict: remove Changes from CO before deleting the CO.
  changeOrder       JobChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: Restrict)
  workPackages      JobChangeWorkPackage[]
  procurementItems  JobProcurementItem[] @relation("ProcurementSourceChange")

  @@index([workspaceId, jobId, status])
  @@index([jobId, number])
  @@index([changeOrderId])
  @@index([sourceRfiId])
  @@index([sourceDirectiveId])
}

model JobChangeWorkPackage {
  id            String         @id @default(cuid())
  changeId      String
  workPackageId String
  change        JobChange      @relation(fields: [changeId], references: [id], onDelete: Cascade)
  workPackage   JobWorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@unique([changeId, workPackageId])
  @@index([workPackageId])
}

/// Formal Change Order that may bundle multiple JobChanges.
/// sellAmount is the approved CO value (may differ from sum of preliminary change pricing).
model JobChangeOrder {
  id            String               @id @default(cuid())
  workspaceId   String
  jobId         String
  number        String
  title         String?
  status        JobChangeOrderStatus @default(DRAFT)
  submittedDate DateTime?
  approvedDate  DateTime?
  /// Explicit approved/submitted CO sell amount. NULL = not set.
  sellAmount    Decimal?             @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job           Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changes       JobChange[]
  invoiceAllocations JobInvoiceChangeOrderAllocation[]

  @@index([workspaceId, jobId, status])
  @@index([jobId, number])
}

/// Project billing invoice / pay application. Explicit amount — not derived from deliveries.
/// Does not track payments/AR. Does not mutate contract baselines or Change Orders.
model JobInvoice {
  id                 String           @id @default(cuid())
  workspaceId        String
  jobId              String
  /// User-controlled invoice / app number (1027, INV-1027, APP-05, …).
  invoiceNumber      String
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  /// Invoice / application date (UTC midnight date-only).
  invoiceDate        DateTime
  dueDate            DateTime?
  status             JobInvoiceStatus @default(DRAFT)
  /// Explicit billed amount. NULL allowed on DRAFT only (unknown). 0 = explicit zero.
  amount             Decimal?         @db.Decimal(14, 2)
  /// Optional bill-to Customer in the same workspace. Not auto-inferred from client/GC.
  billToCustomerId   String?
  /// Optional link to controlled JobDocumentRecord (typically INVOICE type).
  documentRecordId   String?          @unique
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  billToCustomer     Customer?        @relation("JobInvoiceBillTo", fields: [workspaceId, billToCustomerId], references: [workspaceId, id], onDelete: SetNull)
  documentRecord     JobDocumentRecord? @relation(fields: [documentRecordId], references: [id], onDelete: SetNull)
  changeOrderAllocations JobInvoiceChangeOrderAllocation[]

  @@index([workspaceId, jobId, status])
  @@index([jobId, invoiceNumber])
  @@index([jobId, invoiceDate])
  @@index([billToCustomerId])
}

/// Optional provenance: portion of an invoice attributed to a Change Order.
/// amount NULL = linked without a known billed portion. Does not mutate CO.sellAmount.
model JobInvoiceChangeOrderAllocation {
  id             String         @id @default(cuid())
  invoiceId      String
  changeOrderId  String
  amount         Decimal?       @db.Decimal(14, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  invoice        JobInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changeOrder    JobChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, changeOrderId])
  @@index([changeOrderId])
}

/// Job procurement requirement — what is needed. Distinct from JobPurchaseOrder.
/// One item → one optional Work Package (or Job-level). Multi-package coverage is via PO spanning items.
/// Does not auto-mutate fabrication, milestones, package status, or Job.totalCost.
model JobProcurementItem {
  id               String                    @id @default(cuid())
  workspaceId      String
  jobId            String
  /// Null = Job-level. Non-null must belong to the same job.
  workPackageId    String?
  category         JobProcurementCategory    @default(MATERIAL)
  description      String
  quantity         Decimal?                  @db.Decimal(14, 4)
  /// Free-form unit (EA, FT, LB, TON, SQ_FT, LS, …). No conversion engine.
  unit             String?
  status           JobProcurementItemStatus  @default(NEEDED)
  vendorId         String?
  requiredDate     DateTime?
  expectedDate     DateTime?
  /// Convenience mirror of last full completion; partials live on JobProcurementReceipt.
  receivedDate     DateTime?
  /// Internal estimated cost. NULL = unknown; 0 = explicit zero. Not sell price.
  estimatedCost    Decimal?                  @db.Decimal(14, 2)
  /// Internal actual cost. NULL = unknown; 0 = explicit zero.
  actualCost       Decimal?                  @db.Decimal(14, 2)
  purchaseOrderId  String?
  /// Optional provenance to a JobChange. Creating a Change does NOT auto-create procurement.
  sourceChangeId   String?
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job              Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workPackage      JobWorkPackage?           @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  vendor           Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  purchaseOrder    JobPurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  sourceChange     JobChange?                @relation("ProcurementSourceChange", fields: [sourceChangeId], references: [id], onDelete: SetNull)
  receipts         JobProcurementReceipt[]

  @@index([workspaceId, jobId, status])
  @@index([jobId, workPackageId])
  @@index([jobId, vendorId])
  @@index([purchaseOrderId])
  @@index([sourceChangeId])
  @@index([jobId, requiredDate])
  @@index([jobId, expectedDate])
}

/// Commercial purchase order to a supplier. May contain multiple JobProcurementItems across packages.
/// amount is explicit (may include freight/tax/fees) — not forced equal to item cost sum.
model JobPurchaseOrder {
  id               String                 @id @default(cuid())
  workspaceId      String
  jobId            String
  poNumber         String
  vendorId         String?
  status           JobPurchaseOrderStatus @default(DRAFT)
  orderedDate      DateTime?
  expectedDate     DateTime?
  /// Explicit PO total. NULL = unknown. May differ from sum of item costs.
  amount           Decimal?               @db.Decimal(14, 2)
  /// Optional link to controlled JobDocumentRecord (typically PURCHASE_ORDER type).
  documentRecordId String?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job              Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vendor           Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  documentRecord   JobDocumentRecord?     @relation(fields: [documentRecordId], references: [id], onDelete: SetNull)
  items            JobProcurementItem[]

  @@index([workspaceId, jobId, status])
  @@index([jobId, poNumber])
  @@index([vendorId])
  @@index([documentRecordId])
}

/// Partial/full receipt or completion event for a procurement item. Not warehouse inventory.
model JobProcurementReceipt {
  id                String             @id @default(cuid())
  workspaceId       String
  jobId             String
  procurementItemId String
  receivedDate      DateTime
  /// Null when quantity is not applicable (services / LS).
  quantityReceived  Decimal?           @db.Decimal(14, 4)
  /// When true, marks the item fully received/complete regardless of quantity math.
  marksComplete     Boolean            @default(false)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  procurementItem   JobProcurementItem @relation(fields: [procurementItemId], references: [id], onDelete: Cascade)

  @@index([procurementItemId, receivedDate])
  @@index([workspaceId, jobId])
}

/// A piece or assembly this job needs to fabricate.
/// Total hours are quantity × estimatedHoursPerPiece and are not stored.
model JobFabricationItem {
  id                      String   @id @default(cuid())
  workspaceId             String
  jobId                   String
  /// Optional Work Package. Null = Unassigned. Same-job integrity enforced in services
  /// (simple FK + SetNull — avoid composite SET NULL that would null required jobId).
  workPackageId           String?
  name                    String
  quantity                Decimal  @db.Decimal(12, 2)
  estimatedHoursPerPiece  Decimal  @db.Decimal(10, 2)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  job                     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workPackage             JobWorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  shipmentItems           JobShipmentItem[]

  @@index([workspaceId, jobId, sortOrder])
  @@index([jobId, workPackageId])
}

/// Outbound delivery of fabricated product to a project destination.
/// Distinct from JobProcurementReceipt (inbound material/services).
/// Does not mutate WorkPackage status, milestones, fabrication quantities, or Job.totalCost.
model JobShipment {
  id                   String            @id @default(cuid())
  workspaceId          String
  jobId                String
  /// User-controlled ticket / delivery number (DEL-004, Load 3, …).
  deliveryNumber       String
  status               JobShipmentStatus @default(PLANNED)
  plannedShipDate      DateTime?
  actualShipDate       DateTime?
  plannedDeliveryDate  DateTime?
  actualDeliveryDate   DateTime?
  /// Historical destination snapshot — not live-linked to Job site fields.
  destinationName      String?
  destinationAddress1  String?
  destinationAddress2  String?
  destinationCity      String?
  destinationState     String?
  destinationPostalCode String?
  /// Lightweight carrier text — not a Carrier CRM model.
  carrierName          String?
  driverName           String?
  truckNumber          String?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job                  Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items                JobShipmentItem[]
  documents            JobShipmentDocument[]
  installationRecords  JobInstallationRecord[]

  @@index([workspaceId, jobId, status])
  @@index([jobId, deliveryNumber])
  @@index([jobId, plannedDeliveryDate])
  @@index([jobId, plannedShipDate])
}

/// Contents of an outbound delivery. Optional Scope links + always-stored description.
/// FabricationItem quantity is never mutated by shipment lines.
model JobShipmentItem {
  id                String              @id @default(cuid())
  workspaceId       String
  jobId             String
  shipmentId        String
  workPackageId     String?
  fabricationItemId String?
  description       String
  quantity          Decimal?            @db.Decimal(14, 4)
  unit              String?
  notes             String?
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  shipment          JobShipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// SetNull preserves delivery history description when package is removed (service may Restrict delivered history).
  workPackage       JobWorkPackage?     @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  /// SetNull: deleting fabrication scope does not erase shipment history.
  fabricationItem   JobFabricationItem? @relation(fields: [fabricationItemId], references: [id], onDelete: SetNull)

  @@index([shipmentId, sortOrder])
  @@index([jobId, workPackageId])
  @@index([fabricationItemId])
}

model JobShipmentDocument {
  id               String            @id @default(cuid())
  shipmentId       String
  documentRecordId String
  shipment         JobShipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  documentRecord   JobDocumentRecord @relation(fields: [documentRecordId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, documentRecordId])
  @@index([documentRecordId])
}

/// Site erection/installation event. Distinct from delivery-to-site.
/// Does not auto-mutate WorkPackage status or milestones.
model JobInstallationRecord {
  id            String                   @id @default(cuid())
  workspaceId   String
  jobId         String
  workPackageId String?
  shipmentId    String?
  eventType     JobInstallationEventType @default(PROGRESS)
  /// Calendar date (UTC midnight) of the installation event.
  eventDate     DateTime
  participantId String?
  notes         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job           Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workPackage   JobWorkPackage?          @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  shipment      JobShipment?             @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  participant   JobParticipant?          @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([workspaceId, jobId, eventDate])
  @@index([jobId, workPackageId])
  @@index([shipmentId])
}

model JobDocumentFolder {
  id              String              @id @default(cuid())
  workspaceId     String
  jobId           String
  parentFolderId  String?
  name            String
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job             Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parentFolder    JobDocumentFolder?  @relation("JobFolderTree", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders    JobDocumentFolder[] @relation("JobFolderTree")
  files           JobFile[]

  @@index([workspaceId, jobId])
  @@index([jobId, parentFolderId])
  @@unique([jobId, parentFolderId, name])
}

model JobFile {
  id                String                 @id @default(cuid())
  workspaceId       String
  jobId             String
  folderId          String?
  filename          String
  sanitizedFilename String
  mimeType          String
  sizeBytes         Int
  storageKey        String?
  checksum          String?
  uploadStatus      AttachmentUploadStatus @default(PENDING)
  errorMessage      String?
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job               Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  folder            JobDocumentFolder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  documentRecord    JobDocumentRecord?

  @@unique([workspaceId, storageKey])
  @@index([workspaceId, jobId])
  @@index([jobId, folderId])
  @@index([jobId, createdAt])
}

model JobMember {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  role      String?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model JobActivityLog {
  id            String            @id @default(cuid())
  jobId         String
  workspaceId   String
  actorUserId   String?
  action        JobActivityAction
  entityType    String?
  entityId      String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime          @default(now())
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorUserId])
}

model WorkspaceMailbox {
  id                          String        @id @default(cuid())
  workspaceId                 String
  emailAddress                String
  normalizedEmail             String
  provider                    InboxProvider @default(OUTLOOK)
  displayName                 String?
  status                      MailboxStatus @default(ACTIVE)
  ingestionMode               IngestionMode @default(N8N)
  inboxConnectionId           String?
  lastMessageSeenAt           DateTime?
  lastSuccessfulProcessingAt  DateTime?
  lastErrorAt                 DateTime?
  lastErrorMessage            String?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  workspace                   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboxConnection             InboxConnection? @relation(fields: [inboxConnectionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, normalizedEmail])
  @@unique([normalizedEmail, provider])
  @@index([workspaceId, status])
  @@index([normalizedEmail])
  @@index([provider, normalizedEmail])
}

model RoutingRule {
  id              String                @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  enabled         Boolean               @default(true)
  priorityOrder   Int                   @default(100)
  stopProcessing  Boolean               @default(false)
  actionType      RoutingRuleActionType
  matchCriteria   Json
  actionConfig    Json
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser   User?                 @relation("RoutingRuleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?                 @relation("RoutingRuleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, enabled, priorityOrder])
}

model WorkspaceSetting {
  id                                String       @id @default(cuid())
  workspaceId                       String       @unique
  timezone                          String       @default("UTC")
  defaultReviewQueue                ReviewQueue  @default(TRIAGE)
  classificationConfidenceThreshold Decimal      @default(0.7500) @db.Decimal(5, 4)
  taskConfidenceThreshold           Decimal      @default(0.7500) @db.Decimal(5, 4)
  autoCreateTasks                   Boolean      @default(true)
  autoApplyRoutingRules             Boolean      @default(true)
  archiveResolvedAfterDays          Int?
  businessThreshold                 Decimal      @default(0.8500) @db.Decimal(5, 4)
  personalThreshold                 Decimal      @default(0.2000) @db.Decimal(5, 4)
  weightContent                     Decimal      @default(0.4000) @db.Decimal(5, 4)
  weightSender                      Decimal      @default(0.2500) @db.Decimal(5, 4)
  weightSignature                   Decimal      @default(0.1500) @db.Decimal(5, 4)
  weightJob                         Decimal      @default(0.1500) @db.Decimal(5, 4)
  weightSubject                     Decimal      @default(0.0500) @db.Decimal(5, 4)
  createdAt                         DateTime     @default(now())
  updatedAt                         DateTime     @updatedAt
  workspace                         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String    @id @default(cuid())
  workspaceId String
  actorUserId String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser  User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@index([actorUserId])
}

enum EntityType {
  CUSTOMER
  VENDOR
  JOB
}

enum AliasSource {
  MANUAL
  IMPORT
  REVIEW
  OUTLOOK_FOLDER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum DocumentType {
  CUSTOMER_LIST
  VENDOR_LIST
  JOB_LIST
  CLASSIFICATION_GUIDE
  OTHER
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model EntityAlias {
  id              String      @id @default(cuid())
  workspaceId     String
  entityType      EntityType
  customerId      String?
  vendorId        String?
  jobId           String?
  alias           String
  normalizedAlias String
  source          AliasSource @default(IMPORT)
  createdAt       DateTime    @default(now())
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer?   @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: SetNull)
  vendor          Vendor?     @relation(fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: SetNull)
  job             Job?        @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, entityType, normalizedAlias])
  @@index([workspaceId, normalizedAlias])
  @@index([customerId])
  @@index([vendorId])
  @@index([jobId])
}

model EntityContact {
  id              String    @id @default(cuid())
  workspaceId     String
  customerId      String?
  vendorId        String?
  name            String?
  email           String?
  normalizedEmail String?
  domain          String?
  phone           String?
  role            String?
  source          AliasSource @default(IMPORT)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: SetNull)
  vendor          Vendor?   @relation(fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: SetNull)
  jobParticipations JobParticipant[] @relation("JobParticipantContact")

  @@index([workspaceId, normalizedEmail])
  @@index([workspaceId, domain])
  @@index([customerId])
  @@index([vendorId])
}

model KnowledgeDocument {
  id               String         @id @default(cuid())
  workspaceId      String
  filename         String
  mimeType         String
  status           DocumentStatus @default(UPLOADED)
  documentType     DocumentType   @default(OTHER)
  /// COMPANY_UPLOAD | JOB_UPLOAD | IMPORT
  sourceType       String         @default("COMPANY_UPLOAD")
  linkedJobId      String?
  storageReference String?
  extractedText    String?
  /// Structured extract (spreadsheet sheets/tables, parse metadata).
  extractedJson    Json?
  /// NOT_REQUESTED | PENDING | READY | FAILED | SKIPPED
  aiAnalysisStatus String         @default("NOT_REQUESTED")
  aiAnalysisJson   Json?
  fileSize         Int?
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkedJob        Job?           @relation("JobKnowledgeDocuments", fields: [linkedJobId], references: [id], onDelete: SetNull)
  createdByUser    User?          @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  importRuns       ImportRun[]

  @@index([workspaceId, documentType])
  @@index([workspaceId, status])
  @@index([workspaceId, linkedJobId])
  @@index([linkedJobId])
}

model ImportRun {
  id                   String             @id @default(cuid())
  workspaceId          String
  knowledgeDocumentId  String?
  importType           EntityType
  status               ImportStatus       @default(PENDING)
  rowsRead             Int                @default(0)
  createdCount         Int                @default(0)
  updatedCount         Int                @default(0)
  skippedCount         Int                @default(0)
  errorCount           Int                @default(0)
  errorsJson           Json?
  createdAt            DateTime           @default(now())
  completedAt          DateTime?
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeDocument    KnowledgeDocument? @relation(fields: [knowledgeDocumentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, importType])
  @@index([workspaceId, status])
}

model BusinessType {
  id            String    @id @default(cuid())
  workspaceId   String?
  systemKey     String
  displayLabel  String
  description   String?
  displayGroup  String?
  displayOrder  Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, systemKey])
  @@index([systemKey])
  @@index([workspaceId, active])
  @@index([displayGroup, displayOrder])
}

model ClassificationCorrection {
  id                       String    @id @default(cuid())
  workspaceId              String
  classificationId         String
  originalMailboxCategory  String?
  correctedMailboxCategory String?
  originalBusinessType     String?
  correctedBusinessType    String?
  originalCustomerId       String?
  correctedCustomerId      String?
  originalVendorId         String?
  correctedVendorId        String?
  originalJobId            String?
  correctedJobId           String?
  originalPriority         String?
  correctedPriority        String?
  originalTaskData         Json?
  correctedTaskData        Json?
  reason                   String?
  reviewedByUserId         String?
  reviewedAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classification           Classification @relation(fields: [classificationId], references: [id], onDelete: Cascade)
  reviewedByUser           User?     @relation("CorrectionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, classificationId])
  @@index([workspaceId, reviewedAt])
}

model ClassificationInstruction {
  id            String    @id @default(cuid())
  workspaceId   String
  title         String
  content       String
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("InstructionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workspaceId, active])
}

enum FolderStatus {
  DISCOVERED
  APPROVED
  IGNORED
  MATCHED
  ARCHIVED
}

model DiscoveredFolder {
  id                      String       @id @default(cuid())
  workspaceId             String
  inboxConnectionId       String?
  provider                InboxProvider @default(OUTLOOK)
  mailboxEmail            String
  providerFolderId        String
  parentProviderFolderId  String?
  folderPath              String
  rawFolderName           String
  normalizedFolderName    String
  detectedJobNumber       String?
  detectedJobName         String?
  matchedJobId            String?
  matchConfidence         Decimal?     @db.Decimal(5, 4)
  matchReason             String?
  /// True when missing from the latest native/n8n full scan (soft-absent from provider).
  missingFromProvider     Boolean      @default(false)
  status                  FolderStatus @default(DISCOVERED)
  childFolderCount        Int          @default(0)
  firstSeenAt             DateTime     @default(now())
  lastSeenAt              DateTime     @default(now())
  approvedAt              DateTime?
  approvedByUserId        String?
  ignoredAt               DateTime?
  ignoredByUserId         String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  workspace               Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  matchedJob              Job?         @relation(fields: [workspaceId, matchedJobId], references: [workspaceId, id], onDelete: SetNull)

  @@unique([workspaceId, mailboxEmail, providerFolderId])
  @@index([workspaceId, status])
  @@index([workspaceId, normalizedFolderName])
  @@index([workspaceId, inboxConnectionId])
  @@index([matchedJobId])
}

model JobFolderRoot {
  id              String        @id @default(cuid())
  workspaceId     String
  rootName        String
  normalizedName  String
  mailboxEmail    String?
  provider        InboxProvider @default(OUTLOOK)
  providerFolderId String?
  folderPath      String?
  folderName      String?
  active          Boolean       @default(true)
  isActive        Boolean       @default(true)
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, active])
  @@index([workspaceId, isActive])
}

enum ProjectFolderAnalyzeStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Progress + status for native "Analyze Emails" on VERIFIED project folders.
model ProjectFolderEmailAnalyzeRun {
  id                  String                      @id @default(cuid())
  workspaceId         String
  inboxConnectionId   String
  status              ProjectFolderAnalyzeStatus  @default(PENDING)
  /// string[] of DiscoveredFolder ids
  folderIds           Json
  /// Rolling progress counters / current folder (JSON object)
  progress            Json                        @default("{}")
  errorMessage        String?
  initiatedByUserId   String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  workspace           Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, inboxConnectionId, status])
}

enum MailboxReclassifyRunStatus {
  PENDING
  RUNNING
  CANCELLING
  CANCELLED
  COMPLETED
  FAILED
}

enum MailboxReclassifyTaskMode {
  REMOVE_ONLY
  REGENERATE
}

/// Controlled admin reclassification run (canonical mailbox-classify only).
model MailboxReclassifyRun {
  id                  String                     @id @default(cuid())
  workspaceId         String
  inboxConnectionId   String
  status              MailboxReclassifyRunStatus  @default(PENDING)
  /// Snapshot of filter / selection inputs (JSON object; no bodies).
  filtersSnapshot     Json
  /// null = all matching filters; string[] = explicit message ids.
  selectedMessageIds  Json?
  /// REMOVE_ONLY (default): delete classifier tasks after success, skip extraction.
  /// REGENERATE: extract + replace classifier tasks after success.
  taskMode            MailboxReclassifyTaskMode   @default(REMOVE_ONLY)
  totalMatched        Int                        @default(0)
  queued              Int                        @default(0)
  completed           Int                        @default(0)
  failed              Int                        @default(0)
  skipped             Int                        @default(0)
  tasksRemoved        Int                        @default(0)
  tasksGenerated      Int                        @default(0)
  taskPersistFailures Int                        @default(0)
  errorMessage        String?
  initiatedByUserId   String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, inboxConnectionId, status])
}

enum SenderStatus {
  OBSERVED
  LIKELY_BUSINESS
  CONFIRMED_BUSINESS
  CONFIRMED_PERSONAL
  BLOCKED
}

model SenderEvidence {
  id                          String       @id @default(cuid())
  workspaceId                 String
  senderEmail                 String
  normalizedEmail             String
  senderDomain                String
  displayName                 String?
  businessEvidenceCount       Int          @default(0)
  personalEvidenceCount       Int          @default(0)
  manualBusinessConfirmations Int          @default(0)
  manualPersonalConfirmations Int          @default(0)
  lastBusinessAt              DateTime?
  lastPersonalAt              DateTime?
  status                      SenderStatus @default(OBSERVED)
  confidence                  Decimal      @default(0) @db.Decimal(5, 4)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  workspace                   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, normalizedEmail])
  @@index([workspaceId, senderDomain])
  @@index([workspaceId, status])
}

model DomainEvidence {
  id                          String       @id @default(cuid())
  workspaceId                 String
  domain                      String
  isPublicDomain              Boolean      @default(false)
  businessEvidenceCount       Int          @default(0)
  personalEvidenceCount       Int          @default(0)
  manualBusinessConfirmations Int          @default(0)
  manualPersonalConfirmations Int          @default(0)
  status                      SenderStatus @default(OBSERVED)
  confidence                  Decimal      @default(0) @db.Decimal(5, 4)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  workspace                   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([workspaceId, status])
}

enum AttachmentUploadStatus {
  PENDING
  UPLOADED
  FAILED
  REJECTED
}

model EmailAttachment {
  id                    String                @id @default(cuid())
  workspaceId           String
  emailMessageId        String
  provider              InboxProvider?
  providerAttachmentId  String?
  filename              String
  sanitizedFilename     String
  mimeType              String
  sizeBytes             Int
  storageKey            String?
  checksum              String?
  isInline              Boolean               @default(false)
  contentId             String?
  uploadStatus          AttachmentUploadStatus @default(PENDING)
  errorMessage          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailMessage          EmailMessage          @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  relevanceClassifications InlineImageRelevanceClassification[]
  documentRecord        JobDocumentRecord?

  @@unique([workspaceId, emailMessageId, providerAttachmentId])
  @@unique([workspaceId, storageKey])
  @@index([workspaceId, emailMessageId])
  @@index([checksum])
}

/// Metadata about an inline image. The EmailAttachment row and its bytes stay canonical.
enum InlineImageRelevance {
  RELEVANT
  NOISE
  UNCERTAIN
}

enum InlineImageNoiseReason {
  LOGO
  ICON
  SIGNATURE_GRAPHIC
  DECORATIVE
  TRACKING_PIXEL
  BADGE
  REPEATED_BRANDING
  OTHER_NOISE
}

enum InlineImageRelevanceMethod {
  DETERMINISTIC
  VISION
  HUMAN
  HUMAN_CONFIRMED_HASH_MATCH
  MODEL_HASH_MATCH
}

model InlineImageRelevanceClassification {
  id                 String                       @id @default(cuid())
  workspaceId        String
  emailAttachmentId  String
  relevance          InlineImageRelevance
  noiseReason        InlineImageNoiseReason?
  confidence         Float
  method             InlineImageRelevanceMethod
  analyzerVersion    String
  evidence           String
  contentChecksum    String?
  /// Same-workspace attachment whose reviewed or vision result was copied. Not a cross-workspace key.
  sourceAttachmentId String?
  inputTokens        Int?
  outputTokens       Int?
  analyzedAt         DateTime                     @default(now())
  /// Snapshot of the last non-human decision before a human correction (quality measurement).
  priorRelevance     InlineImageRelevance?
  priorNoiseReason   InlineImageNoiseReason?
  priorMethod        InlineImageRelevanceMethod?
  priorConfidence    Float?
  priorEvidence      String?
  correctedAt        DateTime?
  correctedByUserId  String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  workspace          Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailAttachment    EmailAttachment              @relation(fields: [emailAttachmentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, emailAttachmentId, analyzerVersion])
  @@index([workspaceId, contentChecksum, analyzerVersion])
  @@index([workspaceId, relevance])
  @@index([workspaceId, method, correctedAt])
}
